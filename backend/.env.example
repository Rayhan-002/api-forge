# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by django-environ's env.db())
DATABASE_URL=postgres://api_forge:api_forge@localhost:5432/api_forge

# Cache / Redis (leave unset to fall back to an in-process cache in native dev)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Throttling
THROTTLE_RATE_AUTH=10/min
THROTTLE_RATE_EXECUTE=60/min
